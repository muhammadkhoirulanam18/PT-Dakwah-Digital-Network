# PRODUCTION CONFIGURATION FOR RAILWAY
APP_NAME="PT Dakwah Digital Network"
APP_ENV=production
APP_KEY=base64:WtOIcvdK4UhXUQE54To976OVoyRU/EtIpatAJVy/PYA=
APP_DEBUG=false
APP_URL=https://your-api-name.railway.app

# FRONTEND CONNECTION
FRONTEND_URL=https://your-app-name.vercel.app
SANCTUM_STATEFUL_DOMAINS=your-app-name.vercel.app

# DATABASE (Railway usually provides these)
DB_CONNECTION=pgsql
DB_HOST=${{PGHOST}}
DB_PORT=${{PGPORT}}
DB_DATABASE=${{PGDATABASE}}
DB_USERNAME=${{PGUSER}}
DB_PASSWORD=${{PGPASSWORD}}

# SESSION & COOKIE (Important for Auth)
SESSION_DRIVER=database
SESSION_DOMAIN=.railway.app
SESSION_SECURE_COOKIE=true

# API KEYS
OPENAI_API_KEY=your_openai_key_here
